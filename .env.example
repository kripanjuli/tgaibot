NVIDIA_API_KEY=your_nvidia_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Render PostgreSQL Internal Database URL; enable SSL if required by your provider.
DATABASE_URL=postgresql://user:password@host:5432/database
# Telegram numeric user IDs allowed to administer bot commands:
ADMIN_TELEGRAM_IDS=123456789
# Optional: all model IDs here have been manually checked as free. Comma-separated.
FREE_MODELS=z-ai/glm-5.3-flash
# Optional: restrict general bot usage to these IDs. Empty allows all Telegram users.
ALLOWED_TELEGRAM_USER_IDS=
PORT=10000
